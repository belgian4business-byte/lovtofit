// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  goals                Goal[]
  trainingPreferences  TrainingPreferences?
  workoutSessions      WorkoutSession[]
  exerciseProgressions ExerciseProgression[]
  bodyMeasurements     BodyMeasurement[]
  waterIntake          WaterIntake[]
  subscriptions        Subscription[]

  @@map("users")
}

enum GoalType {
  LOSE_WEIGHT
  BUILD_MUSCLE
  GET_STRONGER
  IMPROVE_CONDITION
  GET_FIT
}

enum GoalStatus {
  ACTIVE
  PAUSED
}

// Doelen worden nooit overschreven: bij een doelwijziging blijft het oude
// doel bestaan met status PAUSED (zie CLAUDE.md, Datamodel-regels).
model Goal {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  type      GoalType
  status    GoalStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  pausedAt  DateTime?

  @@map("goals")
}

enum TrainingLocation {
  HOME
  GYM
  BOTH
}

enum Equipment {
  NONE
  DUMBBELLS
  RESISTANCE_BANDS
  KETTLEBELL
  FULL_GYM
}

enum SessionDuration {
  MIN_15
  MIN_30
  MIN_45
  MIN_60_PLUS
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model TrainingPreferences {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id])
  location         TrainingLocation
  equipment        Equipment[]
  sessionDuration  SessionDuration
  weeklyFrequency  Int
  level            ExperienceLevel
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("training_preferences")
}

// Zie blueprint v0.5 (Exercise Library): de 7 hoofdgroepen + mobiliteit/herstel.
enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  ARMS
  LEGS_GLUTES
  CORE
  CARDIO
  MOBILITY
}

// Movement Pattern is belangrijker dan alleen spiergroep: de Training Engine
// vraagt later "geef me een squat + push + pull", niet "drie beenoefeningen"
// (blueprint v0.5, sectie 10).
enum MovementPattern {
  PUSH
  PULL
  SQUAT
  HINGE
  LUNGE
  CARRY
  CORE_STABILITY
  ROTATION
  CARDIO
  MOBILITY
}

enum ExerciseEquipment {
  BODYWEIGHT
  DUMBBELL
  BARBELL
  MACHINE_CABLE
}

model Exercise {
  id              String            @id @default(uuid())
  name            String            @unique
  muscleGroup     MuscleGroup
  movementPattern MovementPattern
  equipment       ExerciseEquipment
  level           ExperienceLevel
  createdAt       DateTime          @default(now())

  loggedSets   LoggedSet[]
  feedback     ExerciseFeedback[]
  progressions ExerciseProgression[]

  @@map("exercises")
}

// Templates zijn regels, geen vaste oefeningen: een template zegt bv.
// "squat + push + pull + hinge + core", en de (latere) Decision Engine
// vult elke slot in met een passende oefening uit de Exercise Library
// (blueprint v0.6, sectie 15 "TEMPLATE = REGELS, NIET OEFENINGEN").
model WorkoutTemplate {
  id        String         @id @default(uuid())
  name      String         @unique
  level     ExperienceLevel
  createdAt DateTime       @default(now())

  slots    TemplateSlot[]
  sessions WorkoutSession[]

  @@map("workout_templates")
}

model TemplateSlot {
  id              String          @id @default(uuid())
  templateId      String
  template        WorkoutTemplate @relation(fields: [templateId], references: [id])
  order           Int
  movementPattern MovementPattern

  @@unique([templateId, order])
  @@map("template_slots")
}

// Eén rij per afgeronde training. We slaan de sessie in één keer op zodra
// de gebruiker "afronden" tikt (CLAUDE.md Fase 2, stap 6) — bewust simpel,
// geen tussentijdse "gestart maar niet afgerond"-status.
model WorkoutSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  templateId  String
  template    WorkoutTemplate @relation(fields: [templateId], references: [id])
  completedAt DateTime @default(now())
  // AI Coach-samenvatting op het moment van opslaan (deterministisch, zie
  // ai-coach.service.ts). Nullable: sessies van vóór deze kolom hebben er
  // geen.
  coachMessage String?

  loggedSets   LoggedSet[]
  feedback     ExerciseFeedback[]
  progressions ExerciseProgression[]

  @@map("workout_sessions")
}

model LoggedSet {
  id         String         @id @default(uuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id])
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])
  setNumber  Int
  reps       Int
  weightKg   Float?

  @@map("logged_sets")
}

// UI-labels: EASY=Makkelijk, GOOD=Goed, HARD=Zwaar, TOO_HARD=Te zwaar
// (CLAUDE.md, Datamodel-regels). "Zwaar" (HARD/TOO_HARD) is nadrukkelijk
// iets anders dan `discomfort` (ongemak/pijn) — dat is een apart signaal
// met voorrang, geen zwaarte-niveau (blueprint v2.12, sectie 2.12.7).
enum Difficulty {
  EASY
  GOOD
  HARD
  TOO_HARD
}

// Eén rij per oefening per sessie (niet per set) — de gebruiker geeft
// feedback nadat hij alle sets van een oefening heeft afgerond.
model ExerciseFeedback {
  id         String         @id @default(uuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id])
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])
  difficulty Difficulty
  discomfort Boolean
  createdAt  DateTime       @default(now())

  @@map("exercise_feedback")
}

// Vijf beslissingen uit blueprint v2.14.1 — de Progression Engine bepaalt
// dit, de (latere) Decision Engine voert het pas echt uit door een andere
// oefening/belasting te kiezen.
enum ProgressionDecision {
  KEEP
  INCREASE
  DECREASE
  REPLACE
  ADJUST
}

// Eén rij per oefening per sessie: het geheugen van de Progression Engine,
// nodig om trends (3x op rij te zwaar/makkelijk) te herkennen zonder op
// één losse training te reageren (blueprint v0.8.6 / v2.14.3).
model ExerciseProgression {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id])
  exerciseId String
  exercise   Exercise            @relation(fields: [exerciseId], references: [id])
  sessionId  String
  session    WorkoutSession      @relation(fields: [sessionId], references: [id])
  decision   ProgressionDecision
  createdAt  DateTime            @default(now())

  @@map("exercise_progressions")
}

// CLAUDE.md-datamodelregel: gewicht wordt nooit los opgeslagen of
// overschreven bij een nieuwe meting — elke meting is een eigen rij, zodat
// er een geschiedenis ontstaat (Fase 5, stap 1; bron: blueprint v1.3 §6 /
// v2.17.4 — "gewicht is een trend, geen dagelijkse beoordeling").
model BodyMeasurement {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  weightKg   Float
  measuredAt DateTime @default(now())

  @@map("body_measurements")
}

// Fase 5, stap 3 (bron: blueprint v1.3 §10 / v2.17.7): elke registratie is
// een losse rij (net als BodyMeasurement) zodat "vandaag" simpelweg de som
// is van de rijen van vandaag — geen los "totaal vandaag"-veld dat apart
// bijgehouden en dus fout kan raken.
model WaterIntake {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  amountMl Int
  loggedAt DateTime @default(now())

  @@map("water_intake")
}

// Fase 6, stap 1 (bron: blueprint v2.19 + v2.25.28/v2.25.29). Een gebruiker
// zonder abonnement-rij is gewoon FREE — er wordt dus niets aangemaakt bij
// registratie.
enum SubscriptionPlan {
  FREE
  PREMIUM
}

// CANCELLED = opgezegd, maar toegang tot `expiresAt` (v2.19.9). EXPIRED
// hoeft niet actief gezet te worden: de FeatureAccessService kijkt zelf naar
// `expiresAt`, dus een verlopen periode geeft ook zonder statuswijziging
// geen toegang meer.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
}

// Meerdere rijen per gebruiker toegestaan (geen @unique op userId): een
// verlenging of nieuwe proefperiode is een nieuwe rij, zodat de historie
// bewaard blijft. De meest recente (op startedAt) telt.
model Subscription {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  plan      SubscriptionPlan
  status    SubscriptionStatus
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, startedAt])
  @@map("subscriptions")
}

// Eén centrale lijst van functies (CAN_USE_*) + per plan of ze aan staan —
// "één regel voor Premium" (v2.19.19), geen `if premium` verspreid door de
// code. `active = false` zet een functie voor iedereen uit (FA-011).
model Feature {
  id          String   @id @default(uuid())
  featureKey  String   @unique
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  planFeatures PlanFeature[]

  @@map("features")
}

model PlanFeature {
  id        String           @id @default(uuid())
  plan      SubscriptionPlan
  featureId String
  feature   Feature          @relation(fields: [featureId], references: [id])
  enabled   Boolean

  @@unique([plan, featureId])
  @@map("plan_features")
}
